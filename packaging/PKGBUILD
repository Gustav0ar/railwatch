# Build from a release source archive; no installation is performed by this repository.
pkgname=railwatch
pkgver=0.1.0
pkgrel=2
pkgdesc='Railwatch telemetry, incidents and electricity costs'
arch=('x86_64' 'aarch64')
license=('GPL-2.0-or-later')
depends=('glibc' 'gcc-libs' 'systemd-libs' 'fontconfig' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo')
# GCC LTO objects from bundled SQLite cannot be consumed by Rust's LLVM linker.
options=('!lto')
optdepends=('libnotify: desktop notifications' 'pipewire: desktop sound via pw-play')
source=("railwatch-$pkgver.tar.gz")
sha256sums=('SKIP')
build() {
  cd "$srcdir/railwatch-$pkgver"
  cargo build --release --locked
  cargo build --release --locked --manifest-path clients/gui/Cargo.toml
}
check() {
  cd "$srcdir/railwatch-$pkgver"
  cargo test --workspace --release --locked
  cargo test --release --locked --manifest-path clients/gui/Cargo.toml
}
package() {
  cd "$srcdir/railwatch-$pkgver"
  install -Dm755 target/release/railwatchd "$pkgdir/usr/bin/railwatchd"
  install -Dm755 target/release/railwatch "$pkgdir/usr/bin/railwatch"
  install -Dm755 clients/gui/target/release/railwatch-gui "$pkgdir/usr/bin/railwatch-gui"
  install -Dm644 packaging/railwatch-gui.desktop "$pkgdir/usr/share/applications/railwatch-gui.desktop"
  install -Dm644 packaging/railwatchd.service "$pkgdir/usr/lib/systemd/system/railwatchd.service"
  install -Dm644 packaging/railwatch-notify.service "$pkgdir/usr/lib/systemd/user/railwatch-notify.service"
  install -Dm644 packaging/60-railwatch.rules "$pkgdir/usr/lib/udev/rules.d/60-railwatch.rules"
  install -Dm644 packaging/railwatch.sysusers "$pkgdir/usr/lib/sysusers.d/railwatch.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/railwatch/README.md"
  install -Dm644 docs/installation.md "$pkgdir/usr/share/doc/railwatch/installation.md"
  install -Dm644 crates/client/interfaces/io.github.railwatch.Monitor1.varlink "$pkgdir/usr/share/varlink/interfaces/io.github.railwatch.Monitor1.varlink"
  install -d "$pkgdir/usr/share/railwatch/noctalia"
  cp -r clients/noctalia/catalog.toml clients/noctalia/railwatch "$pkgdir/usr/share/railwatch/noctalia/"
}
